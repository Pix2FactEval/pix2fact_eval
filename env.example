# Copy to .env and replace placeholders with real values (never commit .env).

BASE_URL=
AK=
DEFAULT_MODEL_NAME=

OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=google/gemini-3.1-pro-preview:online
OPENROUTER_ENABLE_WEB_SEARCH=1

# Agents: SearchTool / VisitTool (see src/agents/)
MODELHUB_SEARCH_URL=<YOUR_MODELHUB_SEARCH_ENDPOINT_URL>
MODELHUB_SEARCH_API_KEY=<YOUR_MODELHUB_SEARCH_API_KEY>
JINA_READER_API_KEY=<YOUR_JINA_READER_API_KEY>
# Agent default OpenAI-compatible backend (Agent._default_client)
OPENAI_COMPAT_BASE_URL=http://localhost:34573/v1
OPENAI_COMPAT_API_KEY=EMPTY
